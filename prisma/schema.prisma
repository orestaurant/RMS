generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String                    @db.VarChar(255)
  slug                     String                    @unique @db.VarChar(255)
  email                    String                    @unique @db.VarChar(255)
  phone                    String?                   @db.VarChar(20)
  country                  String?                   @db.VarChar(100)
  industry                 String?                   @db.VarChar(100)
  subscriptionTier         String                    @default("starter") @db.VarChar(50)
  status                   String                    @default("active") @db.VarChar(50)
  logoUrl                  String?
  websiteUrl               String?
  metadata                 Json                      @default("{}")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  createdBy                String?                   @db.Uuid
  updatedBy                String?                   @db.Uuid
  aggregatorCommissions    AggregatorCommission[]
  aggregatorIntegrations   AggregatorIntegration[]
  aggregatorOrders         AggregatorOrder[]
  aggregatorOrderItems     AggregatorOrderItem[]
  aggregatorPayouts        AggregatorPayout[]
  aggregatorSyncLogs       AggregatorSyncLog[]
  aiGeneratedMenus         AiGeneratedMenu[]
  aiSetupAnswers           AiSetupAnswer[]
  aiSetupRecommendations   AiSetupRecommendation[]
  aiSetupSessions          AiSetupSession[]
  auditLogs                AuditLog[]
  bills                    Bill[]
  billItems                BillItem[]
  billTaxBreakdowns        BillTaxBreakdown[]
  branches                 Branch[]
  branchPerformanceReports BranchPerformanceReport[]
  cashRegisters            CashRegister[]
  cashRegisterSessions     CashRegisterSession[]
  customers                Customer[]
  customerAddresses        CustomerAddress[]
  customerLoyaltyPoints    CustomerLoyaltyPoints[]
  customerNotes            CustomerNote[]
  dailySalesReports        DailySalesReport[]
  InventoryItem            InventoryItem[]
  kitchenSections          KitchenSection[]
  kitchenStatusLogs        KitchenStatusLog[]
  kitchenTickets           KitchenTicket[]
  kitchenTicketItems       KitchenTicketItem[]
  lowStockAlerts           LowStockAlert[]
  menuCategories           MenuCategory[]
  menuItems                MenuItem[]
  menuItemModifierGroups   MenuItemModifierGroup[]
  menuItemVariants         MenuItemVariant[]
  modifiers                Modifier[]
  modifierGroups           ModifierGroup[]
  notifications            Notification[]
  orders                   Order[]
  orderItems               OrderItem[]
  orderItemModifiers       OrderItemModifier[]
  orderStatusLogs          OrderStatusLog[]
  payments                 Payment[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  refunds                  Refund[]
  reservations             Reservation[]
  reservationNoShowLogs    ReservationNoShowLog[]
  reservationPayments      ReservationPayment[]
  restaurants              Restaurant[]
  restaurantSettings       RestaurantSettings[]
  restaurantTables         RestaurantTable[]
  roles                    Role[]
  staffBranchAssignments   StaffBranchAssignment[]
  staffProfiles            StaffProfile[]
  stockAdjustments         StockAdjustment[]
  stockMovements           StockMovement[]
  suppliers                Supplier[]
  tableLayouts             TableLayout[]
  tableQrTokens            TableQrToken[]
  users                    User[]

  @@index([slug])
  @@index([status])
}

model Restaurant {
  id                       String                    @id @default(uuid()) @db.Uuid
  organizationId           String                    @db.Uuid
  name                     String                    @db.VarChar(255)
  slug                     String                    @db.VarChar(255)
  email                    String?                   @db.VarChar(255)
  phone                    String?                   @db.VarChar(20)
  cuisineType              String?                   @db.VarChar(100)
  address                  String?
  latitude                 Decimal?                  @db.Decimal(10, 8)
  longitude                Decimal?                  @db.Decimal(11, 8)
  gstNumber                String?                   @db.VarChar(20)
  fssaiNumber              String?                   @db.VarChar(20)
  establishmentDate        DateTime?                 @db.Date
  status                   String                    @default("active") @db.VarChar(50)
  logoUrl                  String?
  bannerUrl                String?
  description              String?
  maxTables                Int                       @default(20)
  avgTableCapacity         Int                       @default(4)
  operatingHours           Json?
  metadata                 Json                      @default("{}")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  createdBy                String?                   @db.Uuid
  updatedBy                String?                   @db.Uuid
  aggregatorCommissions    AggregatorCommission[]
  aggregatorIntegrations   AggregatorIntegration[]
  aggregatorOrders         AggregatorOrder[]
  aggregatorPayouts        AggregatorPayout[]
  aggregatorSyncLogs       AggregatorSyncLog[]
  aiGeneratedMenus         AiGeneratedMenu[]
  aiSetupRecommendations   AiSetupRecommendation[]
  aiSetupSessions          AiSetupSession[]
  bills                    Bill[]
  branches                 Branch[]
  branchPerformanceReports BranchPerformanceReport[]
  cashRegisters            CashRegister[]
  dailySalesReports        DailySalesReport[]
  InventoryItem            InventoryItem[]
  kitchenSections          KitchenSection[]
  kitchenTickets           KitchenTicket[]
  menuCategories           MenuCategory[]
  menuItems                MenuItem[]
  modifierGroups           ModifierGroup[]
  orders                   Order[]
  purchaseOrders           PurchaseOrder[]
  reservations             Reservation[]
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings                 RestaurantSettings?
  tables                   RestaurantTable[]
  staffProfiles            StaffProfile[]
  suppliers                Supplier[]
  tableLayouts             TableLayout[]
  tableQrTokens            TableQrToken[]

  @@unique([organizationId, slug], name: "idx_restaurant_org_slug")
  @@index([organizationId])
  @@index([status])
}

model RestaurantSettings {
  id                                  String       @id @default(uuid()) @db.Uuid
  restaurantId                        String       @unique @db.Uuid
  organizationId                      String       @db.Uuid
  taxPercentage                       Decimal      @default(5.00) @db.Decimal(5, 2)
  serviceChargePercentage             Decimal      @default(0) @db.Decimal(5, 2)
  discountAllowed                     Boolean      @default(true)
  reservationAdvancePaymentPercentage Decimal      @default(0) @db.Decimal(5, 2)
  reservationCancellationHours        Int          @default(24)
  reservationNoShowPenalty            Decimal      @default(0) @db.Decimal(12, 2)
  qrOrderAutoApprove                  Boolean      @default(false)
  kitchenPrintEnabled                 Boolean      @default(true)
  splitBillAllowed                    Boolean      @default(true)
  advancePaymentRequired              Boolean      @default(false)
  currency                            String       @default("INR") @db.VarChar(10)
  timezone                            String       @default("Asia/Kolkata") @db.VarChar(100)
  aiSetupCompleted                    Boolean      @default(false)
  aiSetupData                         Json         @default("{}")
  createdAt                           DateTime     @default(now())
  updatedAt                           DateTime     @updatedAt
  deletedAt                           DateTime?
  organization                        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant                          Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Branch {
  id                       String                    @id @default(uuid()) @db.Uuid
  restaurantId             String                    @db.Uuid
  organizationId           String                    @db.Uuid
  name                     String                    @db.VarChar(255)
  address                  String
  latitude                 Decimal?                  @db.Decimal(10, 8)
  longitude                Decimal?                  @db.Decimal(11, 8)
  phone                    String?                   @db.VarChar(20)
  email                    String?                   @db.VarChar(255)
  managerId                String?                   @db.Uuid
  status                   String                    @default("active") @db.VarChar(50)
  maxTables                Int                       @default(20)
  isPrimary                Boolean                   @default(false)
  metadata                 Json                      @default("{}")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  createdBy                String?                   @db.Uuid
  updatedBy                String?                   @db.Uuid
  aggregatorOrders         AggregatorOrder[]
  aggregatorPayouts        AggregatorPayout[]
  bills                    Bill[]
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant               Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchPerformanceReports BranchPerformanceReport[]
  cashRegisters            CashRegister[]
  dailySalesReports        DailySalesReport[]
  InventoryItem            InventoryItem[]
  kitchenSections          KitchenSection[]
  kitchenTickets           KitchenTicket[]
  lowStockAlerts           LowStockAlert[]
  orders                   Order[]
  purchaseOrders           PurchaseOrder[]
  reservations             Reservation[]
  tables                   RestaurantTable[]
  staffBranchAssignments   StaffBranchAssignment[]
  stockAdjustments         StockAdjustment[]
  stockMovements           StockMovement[]
  tableLayouts             TableLayout[]
  tableQrTokens            TableQrToken[]

  @@unique([restaurantId, name], name: "idx_branch_restaurant_name")
  @@index([restaurantId])
  @@index([organizationId])
  @@index([status])
}

model User {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String?                @db.Uuid
  email                  String                 @unique @db.VarChar(255)
  phone                  String?                @db.VarChar(20)
  passwordHash           String?                @db.VarChar(255)
  firstName              String?                @db.VarChar(100)
  lastName               String?                @db.VarChar(100)
  role                   UserRoleEnum           @default(ADMIN)
  status                 String                 @default("active") @db.VarChar(50)
  isEmailVerified        Boolean                @default(false)
  isPhoneVerified        Boolean                @default(false)
  lastLoginAt            DateTime?
  lastLoginIp            String?                @db.VarChar(45)
  failedLoginAttempts    Int                    @default(0)
  lockedUntil            DateTime?
  profilePictureUrl      String?
  metadata               Json                   @default("{}")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  createdBy              String?                @db.Uuid
  updatedBy              String?                @db.Uuid
  name                   String                 @default("Admin") @db.VarChar(100)
  password               String                 @default("") @db.VarChar(255)
  aiGeneratedMenuCreated AiGeneratedMenu[]
  aiSetupSessions        AiSetupSession[]
  auditLogs              AuditLog[]
  billCreated            Bill[]                 @relation("created_by")
  billSettled            Bill[]                 @relation("settled_by")
  closedCashSessions     CashRegisterSession[]  @relation("CashRegisterSessionClosedBy")
  openedCashSessions     CashRegisterSession[]  @relation("CashRegisterSessionOpenedBy")
  customerNotes          CustomerNote[]
  kitchenStatusLogs      KitchenStatusLog[]
  lowStockAlerts         LowStockAlert[]
  notifications          Notification[]
  orderConfirmed         Order[]                @relation("confirmed_by")
  orderCreated           Order[]                @relation("created_by")
  orderServed            Order[]                @relation("served_by")
  orderStatusLogs        OrderStatusLog[]
  payments               Payment[]
  purchaseOrderCreated   PurchaseOrder[]
  refunds                Refund[]
  reservationNoShowLogs  ReservationNoShowLog[]
  staffProfile           StaffProfile?
  stockAdjustments       StockAdjustment[]
  stockMovements         StockMovement[]
  organization           Organization?          @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@index([role])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @db.Uuid
  name           String           @db.VarChar(100)
  description    String?
  isSystemRole   Boolean          @default(false)
  status         String           @default("active") @db.VarChar(50)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]

  @@unique([organizationId, name], name: "idx_role_org_name")
  @@index([organizationId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?
  resource    String?          @db.VarChar(100)
  action      String?          @db.VarChar(100)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([resource])
  @@index([action])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "idx_role_permission_unique")
}

model StaffProfile {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @unique @db.Uuid
  restaurantId      String                  @db.Uuid
  organizationId    String                  @db.Uuid
  designation       String?                 @db.VarChar(100)
  employeeId        String?                 @db.VarChar(50)
  phoneNumber       String?                 @db.VarChar(20)
  hireDate          DateTime?               @db.Date
  salary            Decimal?                @db.Decimal(12, 2)
  status            String                  @default("active") @db.VarChar(50)
  documentUrl       String?
  metadata          Json                    @default("{}")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  branchAssignments StaffBranchAssignment[]
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant        Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, employeeId], name: "idx_staff_restaurant_employee")
  @@index([restaurantId])
  @@index([userId])
}

model StaffBranchAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  staffId        String       @db.Uuid
  branchId       String       @db.Uuid
  organizationId String       @db.Uuid
  restaurantId   String       @db.Uuid
  startDate      DateTime     @default(now()) @db.Date
  endDate        DateTime?    @db.Date
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff          StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([branchId])
}

model Customer {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String?                @db.Uuid
  phone             String?                @db.VarChar(20)
  email             String                 @unique @db.VarChar(255)
  firstName         String?                @db.VarChar(100)
  lastName          String?                @db.VarChar(100)
  dateOfBirth       DateTime?              @db.Date
  gender            String?                @db.VarChar(20)
  profilePictureUrl String?
  totalOrders       Int                    @default(0)
  totalSpent        Decimal                @default(0) @db.Decimal(12, 2)
  preferredLanguage String?                @db.VarChar(20)
  status            String                 @default("active") @db.VarChar(50)
  customerSource    String?                @db.VarChar(100)
  metadata          Json                   @default("{}")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  mobile            String?                @db.VarChar(20)
  name              String                 @default("") @db.VarChar(100)
  password          String                 @default("") @db.VarChar(255)
  role              String?                @default("CUSTOMER") @db.VarChar(50)
  bills             Bill[]
  organization      Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses         CustomerAddress[]
  loyaltyPoints     CustomerLoyaltyPoints?
  notes             CustomerNote[]
  orders            Order[]
  payments          Payment[]
  reservations      Reservation[]

  @@unique([organizationId, phone], name: "idx_customer_org_phone")
  @@index([organizationId])
  @@index([phone])
  @@index([email])
}

model CustomerAddress {
  id                String       @id @default(uuid()) @db.Uuid
  customerId        String       @db.Uuid
  organizationId    String       @db.Uuid
  addressType       String?      @db.VarChar(50)
  addressLine1      String
  addressLine2      String?
  city              String?      @db.VarChar(100)
  state             String?      @db.VarChar(100)
  postalCode        String?      @db.VarChar(20)
  latitude          Decimal?     @db.Decimal(10, 8)
  longitude         Decimal?     @db.Decimal(11, 8)
  isDefault         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryAddresses Order[]

  @@index([customerId])
}

model CustomerNote {
  id             String       @id @default(uuid()) @db.Uuid
  customerId     String       @db.Uuid
  organizationId String       @db.Uuid
  note           String?
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  user           User?        @relation(fields: [createdBy], references: [id])
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerLoyaltyPoints {
  id             String       @id @default(uuid()) @db.Uuid
  customerId     String       @unique @db.Uuid
  organizationId String       @db.Uuid
  pointsBalance  Int          @default(0)
  lifetimePoints Int          @default(0)
  lastEarnedAt   DateTime?
  lastRedeemedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model RestaurantTable {
  id             String          @id @default(uuid()) @db.Uuid
  branchId       String          @db.Uuid
  restaurantId   String          @db.Uuid
  organizationId String          @db.Uuid
  tableNumber    String          @db.VarChar(50)
  capacity       Int             @default(4)
  section        String?         @db.VarChar(100)
  status         TableStatusEnum @default(available)
  xPosition      Decimal?        @db.Decimal(10, 2)
  yPosition      Decimal?        @db.Decimal(10, 2)
  rotationAngle  Int             @default(0)
  shape          String?         @db.VarChar(50)
  color          String?         @db.VarChar(20)
  notes          String?
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  bills          Bill[]
  orders         Order[]
  reservations   Reservation[]
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrTokens       TableQrToken[]

  @@unique([branchId, tableNumber], name: "idx_table_branch_number")
  @@index([branchId])
  @@index([status])
}

model TableLayout {
  id             String       @id @default(uuid()) @db.Uuid
  branchId       String       @db.Uuid
  restaurantId   String       @db.Uuid
  organizationId String       @db.Uuid
  name           String?      @db.VarChar(100)
  layoutData     Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model TableQrToken {
  id             String          @id @default(uuid()) @db.Uuid
  tableId        String          @db.Uuid
  branchId       String          @db.Uuid
  restaurantId   String          @db.Uuid
  organizationId String          @db.Uuid
  token          String          @unique @db.VarChar(255)
  qrCodeUrl      String?
  sessionToken   String?         @db.VarChar(255)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table          RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@index([token])
}

model Reservation {
  id                   String                 @id @default(uuid()) @db.Uuid
  branchId             String                 @db.Uuid
  restaurantId         String                 @db.Uuid
  organizationId       String                 @db.Uuid
  customerId           String?                @db.Uuid
  tableId              String?                @db.Uuid
  guestName            String                 @db.VarChar(100)
  guestPhone           String                 @db.VarChar(20)
  guestEmail           String?                @db.VarChar(255)
  numberOfGuests       Int
  reservationDate      DateTime               @db.Date
  reservationTime      DateTime               @db.Time(6)
  durationMinutes      Int                    @default(120)
  status               ReservationStatusEnum  @default(pending)
  advancePaymentAmount Decimal                @default(0) @db.Decimal(12, 2)
  advancePaymentStatus PaymentStatusEnum?
  cancellationReason   String?
  noShowReason         String?
  notes                String?
  source               String?                @db.VarChar(100)
  externalReferenceId  String?                @db.VarChar(100)
  metadata             Json                   @default("{}")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  createdBy            String?                @db.Uuid
  updatedBy            String?                @db.Uuid
  branch               Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer             Customer?              @relation(fields: [customerId], references: [id])
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant           Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table                RestaurantTable?       @relation(fields: [tableId], references: [id])
  noShowLogs           ReservationNoShowLog[]
  payments             ReservationPayment[]

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([reservationDate])
}

model ReservationPayment {
  id              String             @id @default(uuid()) @db.Uuid
  reservationId   String             @db.Uuid
  organizationId  String             @db.Uuid
  amount          Decimal            @db.Decimal(12, 2)
  paymentMethod   PaymentMethodEnum?
  paymentStatus   PaymentStatusEnum  @default(pending)
  transactionId   String?            @db.VarChar(100)
  referenceNumber String?            @db.VarChar(100)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation     Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model ReservationNoShowLog {
  id             String       @id @default(uuid()) @db.Uuid
  reservationId  String       @db.Uuid
  organizationId String       @db.Uuid
  noShowCount    Int?
  totalPenalty   Decimal?     @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime     @default(now())
  createdBy      String?      @db.Uuid
  user           User?        @relation(fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model MenuCategory {
  id             String       @id @default(uuid()) @db.Uuid
  restaurantId   String       @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(100)
  description    String?
  displayOrder   Int          @default(0)
  iconUrl        String?
  color          String?      @db.VarChar(20)
  isActive       Boolean      @default(true)
  status         String       @default("active") @db.VarChar(50)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items          MenuItem[]

  @@unique([restaurantId, name], name: "idx_category_restaurant_name")
  @@index([restaurantId])
}

model MenuItem {
  id                     String                  @id @default(uuid()) @db.Uuid
  restaurantId           String                  @db.Uuid
  organizationId         String                  @db.Uuid
  categoryId             String                  @db.Uuid
  name                   String                  @db.VarChar(255)
  description            String?
  basePrice              Decimal                 @db.Decimal(12, 2)
  costPrice              Decimal?                @db.Decimal(12, 2)
  displayOrder           Int                     @default(0)
  imageUrl               String?
  isVegetarian           Boolean                 @default(false)
